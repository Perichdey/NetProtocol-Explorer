# ==============================================================================
# NetProtocol Explorer — .gitignore
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Ambientes Virtuais Python
.venv/
venv/
ENV/
env/
.env
.venv*/

# Testes e Cobertura
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
frontend/.vite/
.vite/

# NOTA sobre o build de frontend:
# O bundle compilado 'frontend/dist' é mantido para permitir que a aplicação
# seja executada em outra máquina sem necessidade de instalar o Node.js.
# Caso prefira compilar sempre no deploy/CI, descomente a linha abaixo:
# frontend/dist/

# --- IDEs e Editores ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Sistema Operacional ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Arquivos Temporários de Captura e Logs ---
*.log
*.tmp
temp/
tmp/
